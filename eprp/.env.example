# EPRP — Supabase environment (Phase 5C)
# Copy to `.env.local` and fill in from your Supabase project settings.
# NEVER commit real keys. `.env.local` is gitignored.

# Public — safe to expose to the browser (used by the anon browser client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — the service-role key BYPASSES Row Level Security.
# Never prefix with NEXT_PUBLIC_ and never import into client components.
SUPABASE_SERVICE_ROLE_KEY=
